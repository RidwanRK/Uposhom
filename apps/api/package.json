{
  "name": "@uposhom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "applink:smoke": "tsx scripts/applink-smoke.ts",
    "test:applink": "vitest run test/auth.test.ts test/platform-e2e.test.ts test/billing-mock.test.ts test/smoke.test.ts"
  },
  "dependencies": {
    "cron-parser": "^5.10.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@uposhom/applink-client": "workspace:*",
    "@uposhom/db": "workspace:*",
    "@uposhom/schedule-engine": "workspace:*",
    "@uposhom/shared": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
