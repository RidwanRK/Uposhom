# Copy to /opt/uposhom/backup.env on the VM and chmod 600. NEVER commit real values.
# The backup file is already encrypted before it leaves the VM, so any storage is safe to use.
# Choose ONE of the two options.

# --- Option A: any rclone destination (Google Drive, Backblaze B2, another server over SFTP, ...)
# Set up the remote once on the VM with `rclone config`, then name it here as <remote>:<folder>.
# Examples:  gdrive:uposhom-backups     b2:my-bucket/uposhom     sftp-box:/home/me/uposhom-backups
BACKUP_REMOTE=

# --- Option B: Cloudflare R2 (leave BACKUP_REMOTE empty)
# Cloudflare dashboard: R2, create a bucket, then an Object Read & Write API token scoped to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
