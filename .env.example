# Placeholder-only template. NEVER put real values here: this file is committed to a public repo.
# Real values live in /opt/uposhom/.env on the VM (loaded by the compose `env_file:`) and in the
# team's password manager. Copy to .env for local development.

# ---- Runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ---- Reverse proxy (read by Caddy on the VM) ----
API_DOMAIN=api.example.com

# ---- Postgres (compose service + API) ----
POSTGRES_USER=uposhom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uposhom
DATABASE_URL=postgres://uposhom:change-me@postgres:5432/uposhom

# ---- Data store ----
# memory (default, forgets everything on restart) or postgres. postgres needs DATABASE_URL and
# PHONE_ENC_KEY, and creates its tables on boot.
STORE_DRIVER=memory
# AES-256 key for stored phone numbers: 64 hex characters (`openssl rand -hex 32`). Back it up with
# the other secrets: without it every stored number is unreadable.
PHONE_ENC_KEY=

# ---- Job queue ----
# memory (default) or pgboss. pgboss keeps jobs in Postgres and needs DATABASE_URL. Leave it on
# memory until the Postgres stores land, otherwise jobs replay against state that restarted empty.
QUEUE_DRIVER=memory

# ---- Public support contact (shown on /legal/terms, /legal/privacy and /support) ----
# Applink checks that terms, privacy and a support contact are published before approval.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ---- Alerts ----
# Slack or Discord incoming-webhook URL. Fires on Applink configuration errors (wrong IP or
# credentials), charges that need a human, failed Base Size checks and dead-lettered jobs.
ALERT_WEBHOOK_URL=

# ---- Prices and allowances (placeholders until decided with the mentor; see src/billing/config.ts) ----
# Decimal BDT amounts and monthly counts. Leave empty to use the defaults.
PLAN_FAMILY_CIRCLE_AMOUNT=
PLAN_PHARMACY_AMOUNT=
CAAS_AMOUNT_SCAN=
CAAS_AMOUNT_DOCTOR_SUMMARY=
CAAS_AMOUNT_REPORT_EXPLAIN=
FREE_SCANS_PER_MONTH=
FREE_SMS_PER_MONTH=
PREMIUM_SCANS_PER_MONTH=
PREMIUM_SMS_PER_MONTH=

# ---- Sessions ----
# HMAC secret for access tokens, at least 32 characters (`openssl rand -hex 32`). Mandatory in production.
JWT_SECRET=

# ---- Applink (credentials arrive by email after approval; keep dev and prod separate) ----
APPLINK_APP_ID=
APPLINK_PASSWORD=
# Long random string (for example `openssl rand -hex 24`). Mandatory in production. It is part of
# the five callback URLs registered with Applink, so it stays stable once registered.
APPLINK_CALLBACK_PATH_KEY=

# Keyword subscribers put at the start of an MO SMS (UPOSHOM 1). Confirm the real one with Applink.
SMS_KEYWORD=UPOSHOM
# Outbound SMS per second Applink allows this application (E1318). Ask Applink; empty = no spacing.
SMS_MAX_PER_SECOND=
# Sender alias. Only a provisioned alias works (else E1331): leave empty to use the platform default.
APPLINK_SMS_SOURCE_ADDRESS=

# One endpoint variable per enabled service. Unset means that API is not enabled.
# Point these at scripts/mock-applink.mjs (http://127.0.0.1:8089/...) for local development.
# The two CaaS URLs must both be set, or neither.
APPLINK_SMS_SEND_URL=
APPLINK_SUBSCRIPTION_SEND_URL=
APPLINK_SUBSCRIPTION_QUERY_BASE_URL=
APPLINK_SUBSCRIPTION_CHARGING_INFO_URL=
APPLINK_OTP_REQUEST_URL=
APPLINK_OTP_VERIFY_URL=
APPLINK_CAAS_DEBIT_URL=
APPLINK_CAAS_OTP_VERIFY_URL=

# ---- Added by later workstreams (not yet read by the config module) ----
