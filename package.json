{
  "name": "uposhom",
  "version": "0.0.0",
  "private": true,
  "description": "Uposhom (\u0989\u09aa\u09b6\u09ae): Bangla-first personal healthcare organiser. Monorepo root.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @uposhom/api dev",
    "test:live": "RUN_LIVE_TESTS=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/ai/test/live-openrouter.test.ts",
    "applink:smoke": "pnpm --filter @uposhom/api applink:smoke",
    "test:applink": "pnpm --filter @uposhom/applink-client test && pnpm --filter @uposhom/api test:applink",
    "dev:local": "node scripts/dev-local.mjs",
    "web:mock": "node scripts/web-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
